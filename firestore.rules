/**
 * FIRESTORE SECURITY RULES
 * Role: Defines access control, validation, and security constraints for the Firestore database.
 * Integration: Governs all read/write operations for the application, including diagnostic telemetry and system health.
 * 
 * Architectural Note:
 * Implements strict role-based access control (RBAC) and data validation patterns 
 * siphoned from the AI_Agent_OS diagnostic-aware architecture.
 * 
 * Version: 1.1.0-DIAGNOSTIC-AWARE
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    // Verify user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verify ownership of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify system admin status via custom claims
    function isSystemAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'system_admin');
    }

    // Validate schema for diagnostic telemetry
    // Ensures mandatory fields exist and types are strictly enforced
    function isValidTelemetry() {
      return request.resource.data.keys().hasAll(['timestamp', 'status', 'node_version', 'telemetry_id']) &&
             request.resource.data.status is string &&
             request.resource.data.timestamp is number &&
             request.resource.data.node_version is string;
    }

    // --- COLLECTIONS ---

    // Connection test document
    match /test/{testId} {
      allow read: if isAuthenticated();
    }

    // Memories: Authenticated users can read and create memories.
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Evolutions: Authenticated users can read and propose evolutions.
    match /evolutions/{evolutionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.status in ["PROPOSED", "APPROVED", "REJECTED"];
    }

    // State: Global state is readable by all authenticated users.
    match /state/{stateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }

    // Review Queue: Authenticated users can read and create review items.
    match /review_queue/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.status in ["PENDING", "RESOLVED", "IGNORED"];
      allow delete: if isSystemAdmin();
    }

    // Diagnostic Telemetry: System-level monitoring
    // Only authenticated users can read telemetry, write is restricted to system processes or admins
    match /diagnostic_telemetry/{telemetryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTelemetry();
      allow update, delete: if isSystemAdmin();
    }

    // System Health: Real-time status reporting
    match /system_health/{healthId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }
    
    // Default Deny: Explicitly block all unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}