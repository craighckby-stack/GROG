/**
 * ARCHITECTURAL ENVIRONMENT SPECIFICATION
 * Role: Configuration template and schema contract for local and cloud runtimes.
 * Integration: Consumed by lib/env-validator.ts, diagnostic engines, and agent kernels.
 * 
 * This file serves as the source of truth for system-wide configuration.
 * Ensure all variables are mirrored in your local .env file.
 */

# ==============================================================================
# ARCHITECTURAL ENVIRONMENT SPECIFICATION
# Role: Configuration template and schema contract for local and cloud runtimes.
# Integration: Consumed by lib/env-validator.ts, diagnostic engines, and agent kernels.
# 
# This file serves as the source of truth for system-wide configuration.
# Ensure all variables are mirrored in your local .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMARY CORE CONFIGURATION
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for primary Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# EXTENDED LLM PROVIDER & FALLBACK ROUTING
# ------------------------------------------------------------------------------

# OPENAI_API_KEY: Optional secondary provider key for consensus cross-validation.
OPENAI_API_KEY=""

# DEEPSEEK_API_KEY: Optional tertiary provider key for reasoning kernel fallback.
DEEPSEEK_API_KEY=""

# LOCAL_LLM_ENDPOINT: Local inference server endpoint (e.g. Ollama/vLLM/Termux).
# Used for air-gapped or low-latency local agent execution.
LOCAL_LLM_ENDPOINT="http://localhost:11434/v1"

# ------------------------------------------------------------------------------
# SYSTEM DIAGNOSTICS & TELEMETRY (AI_AGENT_OS COMPLIANT)
# ------------------------------------------------------------------------------

# DIAGNOSTICS_ENABLED: Toggles real-time health checks and memory leak validation.
# Set to 'true' to enable the diagnostic-engine.ts suite.
DIAGNOSTICS_ENABLED="true"

# TELEMETRY_LEVEL: Telemetry logging verbosity (DEBUG, INFO, WARN, ERROR).
TELEMETRY_LEVEL="INFO"

# ------------------------------------------------------------------------------
# STORAGE & MEMORY PERSISTENCE
# ------------------------------------------------------------------------------

# MEMORY_STORAGE_PATH: Flat-file or SQLite state persistence directory.
# Must be writable by the process owner.
MEMORY_STORAGE_PATH="./memory"

# PERSISTENCE_MAX_ENTRIES: Maximum cached state entries retained in memory.
# Used by the memory-persistence layer to prevent heap overflow.
PERSISTENCE_MAX_ENTRIES="10000"

# ------------------------------------------------------------------------------
# SANDBOX & CONSENSUS ENGINE PARAMETERS
# ------------------------------------------------------------------------------

# ZERO_LEAK_SANDBOX_TIMEOUT_MS: Execution timeout for isolated code runners.
# Prevents infinite loops in untrusted agentic code execution.
ZERO_LEAK_SANDBOX_TIMEOUT_MS="5000"

# CONSENSUS_MIN_AGREEMENT_RATIO: Minimum ratio (0.0 - 1.0) required for multi-agent quorum.
# Defines the threshold for cross-provider validation logic.
CONSENSUS_MIN_AGREEMENT_RATIO="0.66"

# ------------------------------------------------------------------------------
# END OF CONFIGURATION
# ------------------------------------------------------------------------------